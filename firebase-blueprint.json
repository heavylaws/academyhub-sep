{
  "entities": {
    "Academy": {
      "title": "Academy",
      "description": "Sports academy entity managing teams, coaches, and athletes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 128 },
        "subdomain": { "type": "string", "maxLength": 64 },
        "sport": { "type": "string", "maxLength": 64 },
        "tier": { "type": "string", "enum": ["free", "starter", "pro", "enterprise"] },
        "status": { "type": "string", "enum": ["active", "suspended", "trial"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "sport", "status"]
    },
    "PlatformAdmin": {
      "title": "PlatformAdmin",
      "description": "Marker document designating platform-wide administrative privileges (console created only)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "AcademyMember": {
      "title": "AcademyMember",
      "description": "Scoped membership within an academy with specific permission role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "academyId": { "type": "string" },
        "role": { "type": "string", "enum": ["academy_admin", "coach", "accounting", "athlete", "guardian"] },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string", "maxLength": 128 },
        "inviteId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "academyId", "role", "email", "name"]
    },
    "AcademyInvite": {
      "title": "AcademyInvite",
      "description": "Pending or accepted invitation for an academy role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "academyId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["academy_admin", "coach", "accounting", "athlete", "guardian"] },
        "status": { "type": "string", "enum": ["pending", "accepted"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["academyId", "email", "role", "status", "createdBy"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "academyId": { "type": "string" },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["platform_admin", "academy_admin", "coach", "athlete", "guardian"] },
        "status": { "type": "string", "enum": ["active", "invited", "disabled"] },
        "phone": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "name", "role", "status"]
    },
    "Athlete": {
      "title": "Athlete",
      "description": "Academy athlete profile and sports metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "academyId": { "type": "string" },
        "userId": { "type": "string" },
        "guardianUids": { "type": "array", "items": { "type": "string" } },
        "firstName": { "type": "string", "maxLength": 64 },
        "lastName": { "type": "string", "maxLength": 64 },
        "dateOfBirth": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "status": { "type": "string", "enum": ["active", "inactive", "injured"] },
        "primaryPosition": { "type": "string", "maxLength": 32 },
        "secondaryPosition": { "type": "string", "maxLength": 32 },
        "jerseyNumber": { "type": "string", "maxLength": 8 },
        "medicalNotes": { "type": "string", "maxLength": 500 },
        "emergencyContactName": { "type": "string", "maxLength": 128 },
        "emergencyContactPhone": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" }
      },
      "required": ["academyId", "firstName", "lastName", "status"]
    },
    "AthletePin": {
      "title": "AthletePin",
      "description": "Kiosk check-in PIN stored separately for staff access only",
      "type": "object",
      "properties": {
        "athleteId": { "type": "string" },
        "academyId": { "type": "string" },
        "pin": { "type": "string", "maxLength": 16 },
        "updatedAt": { "type": "string" }
      },
      "required": ["athleteId", "academyId", "pin"]
    },
    "Team": {
      "title": "Team",
      "description": "Academy sports team squad",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "academyId": { "type": "string" },
        "name": { "type": "string", "maxLength": 128 },
        "ageGroup": { "type": "string", "maxLength": 32 },
        "gender": { "type": "string", "enum": ["male", "female", "coed"] },
        "color": { "type": "string", "maxLength": 32 },
        "season": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" }
      },
      "required": ["academyId", "name", "ageGroup"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Membership mapping athlete to team with position and jersey",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teamId": { "type": "string" },
        "athleteId": { "type": "string" },
        "academyId": { "type": "string" },
        "jerseyNumber": { "type": "string", "maxLength": 8 },
        "position": { "type": "string", "maxLength": 32 },
        "isCaptain": { "type": "boolean" },
        "joinedAt": { "type": "string" }
      },
      "required": ["teamId", "athleteId", "academyId"]
    },
    "TrainingSession": {
      "title": "TrainingSession",
      "description": "Scheduled training or match session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "academyId": { "type": "string" },
        "teamId": { "type": "string" },
        "title": { "type": "string", "maxLength": 128 },
        "sessionType": { "type": "string", "enum": ["training", "match", "tactical", "fitness"] },
        "status": { "type": "string", "enum": ["scheduled", "in_progress", "completed", "cancelled"] },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "location": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 1000 },
        "coachId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["academyId", "teamId", "title", "startTime", "endTime", "status"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Athlete attendance tracking record for a training session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "athleteId": { "type": "string" },
        "academyId": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent", "late", "excused"] },
        "checkInTime": { "type": "string" },
        "notes": { "type": "string", "maxLength": 256 },
        "method": { "type": "string", "enum": ["kiosk", "coach", "manual"] }
      },
      "required": ["sessionId", "athleteId", "academyId", "status"]
    },
    "TacticalPlan": {
      "title": "TacticalPlan",
      "description": "Interactive tactical board formations, movements, and phases",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "drillId": { "type": "string" },
        "academyId": { "type": "string" },
        "title": { "type": "string", "maxLength": 128 },
        "pitchType": { "type": "string", "enum": ["full", "half_attacking", "half_defending", "penalty_box", "futsal", "small_sided"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "authorId": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "pitchType"]
    },
    "SoccerDrillItem": {
      "title": "SoccerDrillItem",
      "description": "Drill library catalog item or custom academy drill",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "academyId": { "type": "string" },
        "title": { "type": "string", "maxLength": 128 },
        "ageGroup": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "maxLength": 64 },
        "categoryLabel": { "type": "string", "maxLength": 64 },
        "difficulty": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "durationMinutes": { "type": "number" },
        "summary": { "type": "string", "maxLength": 1000 },
        "setup": { "type": "string", "maxLength": 1000 },
        "isCustom": { "type": "boolean" },
        "version": { "type": "string", "maxLength": 16 },
        "createdByName": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "ageGroup", "category", "durationMinutes", "summary"]
    },
    "AthleteFee": {
      "title": "AthleteFee",
      "description": "Academy athlete fee assessment and dues",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "academyId": { "type": "string" },
        "athleteId": { "type": "string" },
        "userId": { "type": "string" },
        "guardianUids": { "type": "array", "items": { "type": "string" } },
        "label": { "type": "string", "maxLength": 128 },
        "amountDue": { "type": "number" },
        "currency": { "type": "string", "maxLength": 8 },
        "dueDate": { "type": "string" },
        "status": { "type": "string", "enum": ["unpaid", "partially_paid", "paid", "overdue", "pending", "partial"] },
        "notes": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["academyId", "athleteId", "amountDue", "currency", "dueDate", "status"]
    },
    "FeePayment": {
      "title": "FeePayment",
      "description": "Recorded payment toward an athlete fee",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "academyId": { "type": "string" },
        "feeId": { "type": "string" },
        "athleteId": { "type": "string" },
        "userId": { "type": "string" },
        "guardianUids": { "type": "array", "items": { "type": "string" } },
        "amountPaid": { "type": "number" },
        "paidAt": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["cash", "card", "bank_transfer", "other"] },
        "recordedBy": { "type": "string" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["feeId", "amountPaid", "paidAt", "recordedBy"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Billing invoice for academy fees",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "academyId": { "type": "string" },
        "athleteId": { "type": "string" },
        "invoiceNumber": { "type": "string", "maxLength": 32 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 8 },
        "status": { "type": "string", "enum": ["draft", "issued", "paid", "overdue", "cancelled"] },
        "dueDate": { "type": "string" },
        "issueDate": { "type": "string" },
        "paidDate": { "type": "string" },
        "description": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" }
      },
      "required": ["academyId", "athleteId", "amount", "currency", "status", "dueDate"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Academy noticeboard post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "academyId": { "type": "string" },
        "title": { "type": "string", "maxLength": 128 },
        "content": { "type": "string", "maxLength": 3000 },
        "category": { "type": "string", "enum": ["general", "match", "emergency", "schedule", "training"] },
        "authorId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 64 },
        "publishedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["academyId", "title", "content", "category"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat channel between coaches, athletes, or guardians",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "academyId": { "type": "string" },
        "title": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["direct", "team", "broadcast"] },
        "participantUids": { "type": "array", "items": { "type": "string" } },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "athleteId": { "type": "string" },
        "contextType": { "type": "string" },
        "contextId": { "type": "string" },
        "contextTitle": { "type": "string" },
        "lastMessageText": { "type": "string", "maxLength": 2000 },
        "lastMessageAt": { "type": "string" },
        "lastSenderId": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["academyId", "participantUids"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message in a conversation channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "academyId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string", "maxLength": 64 },
        "senderRole": { "type": "string", "maxLength": 32 },
        "content": { "type": "string", "maxLength": 2000 },
        "text": { "type": "string", "maxLength": 2000 },
        "readBy": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["conversationId", "senderId"]
    },
    "TrainingPlan": {
      "title": "TrainingPlan",
      "description": "Individualized training development plan for an athlete",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "academyId": { "type": "string" },
        "athleteId": { "type": "string" },
        "userId": { "type": "string" },
        "athleteUserId": { "type": "string" },
        "guardianUids": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 1000 },
        "startDate": { "type": "string" },
        "targetDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "archived"] },
        "assignedBy": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["academyId", "athleteId", "title", "status"]
    },
    "PlanItem": {
      "title": "PlanItem",
      "description": "Specific exercise or drill target within an athlete training plan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "academyId": { "type": "string" },
        "planId": { "type": "string" },
        "userId": { "type": "string" },
        "athleteUserId": { "type": "string" },
        "guardianUids": { "type": "array", "items": { "type": "string" } },
        "exercise": { "type": "string", "maxLength": 128 },
        "target": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "order": { "type": "number" },
        "completed": { "type": "boolean" },
        "result": { "type": "string", "maxLength": 128 }
      },
      "required": ["planId", "exercise", "order"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "Performance metric evaluation record for an athlete",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "academyId": { "type": "string" },
        "athleteId": { "type": "string" },
        "userId": { "type": "string" },
        "athleteUserId": { "type": "string" },
        "guardianUids": { "type": "array", "items": { "type": "string" } },
        "sessionId": { "type": "string" },
        "metric": { "type": "string", "maxLength": 64 },
        "value": { "type": "number" },
        "unit": { "type": "string", "maxLength": 16 },
        "notes": { "type": "string", "maxLength": 500 },
        "assessedOn": { "type": "string" },
        "assessedBy": { "type": "string" },
        "conductedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["academyId", "athleteId", "metric", "value", "unit"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": "PlatformAdmin",
      "description": "Platform administrator marker documents (manual console creation only)"
    },
    "/academies/{academyId}": {
      "schema": "Academy",
      "description": "Academy entity configuration"
    },
    "/academies/{academyId}/members/{uid}": {
      "schema": "AcademyMember",
      "description": "Academy membership document mapping user to verified role"
    },
    "/academies/{academyId}/invites/{inviteId}": {
      "schema": "AcademyInvite",
      "description": "Academy invitation with role and pending/accepted status"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with role-based permissions"
    },
    "/academies/{academyId}/athletes/{athleteId}": {
      "schema": "Athlete",
      "description": "Academy athletes registry scoped to academy"
    },
    "/academies/{academyId}/athletePins/{athleteId}": {
      "schema": "AthletePin",
      "description": "Kiosk check-in PIN stored separately for staff access only"
    },
    "/academies/{academyId}/teams/{teamId}": {
      "schema": "Team",
      "description": "Teams and squads scoped to academy"
    },
    "/academies/{academyId}/teamMembers/{memberId}": {
      "schema": "TeamMember",
      "description": "Team roster memberships scoped to academy"
    },
    "/academies/{academyId}/trainingSessions/{sessionId}": {
      "schema": "TrainingSession",
      "description": "Academy training sessions and matches scoped to academy"
    },
    "/academies/{academyId}/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Training session attendance records scoped to academy"
    },
    "/academies/{academyId}/fees/{feeId}": {
      "schema": "AthleteFee",
      "description": "Academy athlete fee assessments and dues"
    },
    "/academies/{academyId}/payments/{paymentId}": {
      "schema": "FeePayment",
      "description": "Recorded payments towards athlete fees"
    },
    "/academies/{academyId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Academy fee invoices"
    },
    "/academies/{academyId}/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Academy noticeboard announcements readable by academy members and writable by staff"
    },
    "/academies/{academyId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Messaging conversation channels restricted to listed participantUids"
    },
    "/academies/{academyId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages within conversation channel authored by authenticated sender"
    },
    "/academies/{academyId}/drills/{drillId}": {
      "schema": "SoccerDrillItem",
      "description": "Academy drill library items with staff-write and member-read permissions"
    },
    "/academies/{academyId}/trainingPlans/{planId}": {
      "schema": "TrainingPlan",
      "description": "Academy athlete training plans with staff-write and member-read permissions (restricted to athlete/guardian)"
    },
    "/academies/{academyId}/planItems/{itemId}": {
      "schema": "PlanItem",
      "description": "Individual items and exercises of an athlete training plan"
    },
    "/academies/{academyId}/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "Academy athlete performance assessments with staff-write and member-read permissions (restricted to athlete/guardian)"
    },
    "/academies/{academyId}/tacticalBoards/{boardId}": {
      "schema": "TacticalPlan",
      "description": "Academy interactive tactical boards with staff-write and member-read permissions"
    }
  }
}
