VITE_LOCAL_DEV=false
VITE_DEMO_ADMIN_PASSWORD=A!t3r3g0

# ------------------------------------------------------------------------------
# 2. CONVEX BACKEND & CLOUD RUN SERVICES
# Set in Convex Cloud dashboard or via: npx convex env set <NAME> <VALUE>
# ------------------------------------------------------------------------------
CONVEX_SITE_URL=https://ais-dev-23owy5nzskayyzseqaf4uc-169293484179.europe-west2.run.app
SITE_URL=https://ais-dev-23owy5nzskayyzseqaf4uc-169293484179.europe-west2.run.app
PLATFORM_ADMIN_EMAILS=ah.baalbaki@gmail.com,heavylaws@gmail.com
