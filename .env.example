# Set to your live Convex deployment URL (e.g., https://<deployment>.convex.cloud) if using Convex Cloud.
# If omitted or left empty, PeakForm runs in self-contained local mode with pre-seeded data.
VITE_CONVEX_URL=
VITE_LOCAL_DEV=true
# Mock-mode demo password for the built-in "heavylaws" super-admin persona.
# NOT a secret: VITE_* values are embedded in the public JS bundle, and mock
# mode has no server-side security. Leave empty to disable that login; never
# reuse a real password here.
VITE_DEMO_ADMIN_PASSWORD=

# Opt-in Firestore multi-device sync. Requires Firebase sign-in and academy
# membership documents (see firestore.rules). Leave false unless configured.
VITE_ENABLE_CLOUD_SYNC=false
