# Resend Transactional Email Provider
RESEND_API_KEY=
EMAIL_FROM=ah.baalbaki@gmail.com

# ------------------------------------------------------------------------------
# 3. AI PIPELINE & GOOGLE AI STUDIO (Gemini API)
# Used server-side exclusively by Convex backend actions via @google/genai
# (convex/videoAnalysis.ts and convex/tacticalAi.ts).
# Model: gemini-2.0-flash with resilient fallback and automated timeout recovery.
# Set via: npx convex env set GEMINI_API_KEY <your-api-key>
# NOTE: Do NOT prefix with VITE_ to keep backend keys strictly out of client bundle.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
