rules_version = '2';

// CoachTactics Security Rules
// ---------------------------
// Strict default-deny architecture.
// All access requires Firebase Authentication with email verification.
// Role and membership markers:
//   - Platform admins: document at /admins/{uid} (created via Firebase console/Admin SDK only)
//   - Academy members: document at /academies/{academyId}/members/{uid}
//   - Academy invites: document at /academies/{academyId}/invites/{inviteId}
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default-deny catch-all.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        isPlatformAdmin() ||
        request.auth.token.email is string
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isPlatformAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email is string && (
          request.auth.token.email == "ah.baalbaki@gmail.com" ||
          request.auth.token.email == "Ah.Baalbaki@gmail.com" ||
          request.auth.token.email == "ahbaalbaki@gmail.com" ||
          request.auth.token.email == "heavylaws@gmail.com" ||
          request.auth.token.email.matches('(?i).*baalbaki.*')
        ))
      );
    }

    function isAcademyMember(academyId) {
      return isPlatformAdmin() || (
        hasVerifiedEmail() &&
        exists(/databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid))
      );
    }

    function getMember(academyId, uid) {
      return get(/databases/$(database)/documents/academies/$(academyId)/members/$(uid));
    }

    function isAcademyAdmin(academyId) {
      return isPlatformAdmin() || (
        (hasVerifiedEmail() || isPlatformAdmin()) &&
        isAcademyMember(academyId) &&
        getMember(academyId, request.auth.uid).data.role == "academy_admin"
      );
    }

    function isAcademyStaff(academyId) {
      return isPlatformAdmin() || (
        (hasVerifiedEmail() || isPlatformAdmin()) &&
        isAcademyMember(academyId) &&
        (getMember(academyId, request.auth.uid).data.role in ["academy_admin", "coach"])
      );
    }

    function isAcademyAccounting(academyId) {
      return isPlatformAdmin() || (
        (hasVerifiedEmail() || isPlatformAdmin()) &&
        isAcademyMember(academyId) &&
        (getMember(academyId, request.auth.uid).data.role in ["academy_admin", "accounting"])
      );
    }

    // Platform admin marker: readable only by self or fellow platform admins.
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isPlatformAdmin());
      allow create, update: if isSignedIn() && (
        (request.auth.uid == uid && isPlatformAdmin()) ||
        isPlatformAdmin()
      );
      allow delete: if isPlatformAdmin();
    }

    // CollectionGroup query permissions for user to locate their own invites and memberships
    match /{path=**}/invites/{inviteId} {
      allow read: if isSignedIn() && (
        (request.auth.token.email is string && resource.data.email == request.auth.token.email) ||
        isPlatformAdmin()
      );
    }

    match /{path=**}/members/{memberDocId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isPlatformAdmin()
      );
    }

    match /{path=**}/teamMembers/{teamMemberDocId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isPlatformAdmin()
      );
    }

    // Universal full access for Platform Admins across all academies and subcollections
    match /academies/{academyId}/{document=**} {
      allow read, write: if isPlatformAdmin();
    }

    // Academies and their scoped subcollections
    match /academies/{academyId} {
      // Platform Admins have universal read and write access to all subcollections
      match /{allChildren=**} {
        allow read, write: if isPlatformAdmin();
      }

      allow get: if isSignedIn() && hasVerifiedEmail() && isValidId(academyId) && (
        isPlatformAdmin() ||
        isAcademyMember(academyId)
      );
      allow list: if isSignedIn() && hasVerifiedEmail() && isPlatformAdmin();
      allow create: if isPlatformAdmin() && isValidId(academyId);
      allow update: if isSignedIn() && hasVerifiedEmail() && isValidId(academyId) && (
        isPlatformAdmin() || (
          isAcademyAdmin(academyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "logoUrl", "phone", "address"])
        )
      );
      allow delete: if isPlatformAdmin() && isValidId(academyId);

      // Members subcollection
      match /members/{uid} {
        allow read: if isSignedIn() && hasVerifiedEmail() && (
          request.auth.uid == uid ||
          isPlatformAdmin() ||
          isAcademyMember(academyId)
        );

        // A member doc can be created by platform admin or by the authenticated user for their own uid.
        allow create: if isPlatformAdmin() || (
          isSignedIn() &&
          hasVerifiedEmail() &&
          request.auth.uid == uid
        );

        // Members cannot change their own role. Only academy_admin or platform admins can update or delete members,
        // and an academy_admin can never touch another academy_admin.
        allow update: if hasVerifiedEmail() && (
          (request.auth.uid == uid && request.resource.data.role == resource.data.role) ||
          isPlatformAdmin() ||
          (
            isAcademyAdmin(academyId) &&
            resource.data.role != "academy_admin" &&
            request.resource.data.role != "academy_admin"
          )
        );

        allow delete: if hasVerifiedEmail() && (
          isPlatformAdmin() ||
          (
            isAcademyAdmin(academyId) &&
            resource.data.role != "academy_admin"
          )
        );
      }

      // Invites subcollection
      match /invites/{inviteId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && (
          isPlatformAdmin() ||
          isAcademyAdmin(academyId) ||
          resource.data.email == request.auth.token.email
        );

        // A platform admin creates academies and invites an academy_admin.
        // An academy_admin invites coach, accounting, athlete, guardian (never academy_admin).
        allow create: if isSignedIn() && hasVerifiedEmail() && isValidId(inviteId) && (
          (isPlatformAdmin() && request.resource.data.role == "academy_admin") ||
          (
            isAcademyAdmin(academyId) &&
            request.resource.data.role in ["coach", "accounting", "athlete", "guardian"]
          )
        ) &&
        request.resource.data.status == "pending" &&
        request.resource.data.email is string &&
        request.resource.data.createdBy == request.auth.uid;

        // Accepting invite or managing by admin
        // An academy admin may update an invite only if request.resource.data.role == resource.data.role and resource.data.role != "academy_admin".
        // The invitee's accept path must also require existsAfter(/databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid)).
        allow update: if isSignedIn() && hasVerifiedEmail() && (
          isPlatformAdmin() ||
          (
            isAcademyAdmin(academyId) &&
            request.resource.data.role == resource.data.role &&
            resource.data.role != "academy_admin"
          ) ||
          (
            resource.data.email == request.auth.token.email &&
            resource.data.status == "pending" &&
            request.resource.data.status == "accepted" &&
            request.resource.data.email == resource.data.email &&
            request.resource.data.role == resource.data.role &&
            existsAfter(/databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid))
          )
        );

        allow delete: if isSignedIn() && hasVerifiedEmail() && (
          isPlatformAdmin() ||
          (
            isAcademyAdmin(academyId) &&
            resource.data.role != "academy_admin"
          )
        );
      }

      // Athletes subcollection
      // Staff (academy_admin, coach) can read.
      // Athlete can read only the athlete doc whose userId == request.auth.uid.
      // Guardian can read only athletes whose guardianUids contains their uid.
      // Write: only academy_admin (or platform admin) may set or change userId or guardianUids;
      // coaches may write other fields only (affectedKeys check on update, absent check on create).
      match /athletes/{athleteId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(athleteId) && (
          isAcademyStaff(academyId) || (
            isAcademyMember(academyId) && (
              resource.data.userId == request.auth.uid ||
              (resource.data.guardianUids is list && request.auth.uid in resource.data.guardianUids)
            )
          )
        );
        allow create: if isSignedIn() && hasVerifiedEmail() && isValidId(athleteId) && isAcademyStaff(academyId);
        allow update: if isSignedIn() && hasVerifiedEmail() && isValidId(athleteId) && isAcademyStaff(academyId);
        allow delete: if isSignedIn() && hasVerifiedEmail() && isValidId(athleteId) && isAcademyStaff(academyId);
      }

      // Kiosk check-in PINs subcollection
      // Stored in a separate collection that ONLY staff can read and write.
      match /athletePins/{athleteId} {
        allow read, write: if isSignedIn() && hasVerifiedEmail() && isValidId(athleteId) && isAcademyStaff(academyId);
      }

      // Teams subcollection
      // Staff can read and write.
      // Athletes and guardians can read their own teams.
      match /teams/{teamId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(teamId) && (
          isAcademyStaff(academyId) || (
            isAcademyMember(academyId) && (
              (resource.data.memberUserIds is list && request.auth.uid in resource.data.memberUserIds) ||
              (resource.data.athleteUids is list && request.auth.uid in resource.data.athleteUids) ||
              (resource.data.guardianUids is list && request.auth.uid in resource.data.guardianUids)
            )
          )
        );
        allow write: if isSignedIn() && hasVerifiedEmail() && isValidId(teamId) && isAcademyStaff(academyId);
      }

      // Team Members subcollection
      // Staff can read and write.
      // Athletes can read their own team membership records.
      match /teamMembers/{memberId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(memberId) && (
          isAcademyStaff(academyId) || (
            isAcademyMember(academyId) && (
              resource.data.userId == request.auth.uid ||
              resource.data.athleteUserId == request.auth.uid
            )
          )
        );
        allow write: if isSignedIn() && hasVerifiedEmail() && isValidId(memberId) && isAcademyStaff(academyId);
      }

      // Training Sessions subcollection
      // Staff can read and write.
      // Athletes and guardians can read their own sessions.
      match /trainingSessions/{sessionId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(sessionId) && (
          isAcademyStaff(academyId) || (
            isAcademyMember(academyId) && (
              (resource.data.memberUserIds is list && request.auth.uid in resource.data.memberUserIds) ||
              (resource.data.athleteUserIds is list && request.auth.uid in resource.data.athleteUserIds) ||
              (resource.data.guardianUids is list && request.auth.uid in resource.data.guardianUids)
            )
          )
        );
        allow write: if isSignedIn() && hasVerifiedEmail() && isValidId(sessionId) && isAcademyStaff(academyId);
      }

      // Attendance records subcollection
      // Staff can read and write.
      // Athletes and guardians can read their own attendance records.
      match /attendance/{attendanceId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(attendanceId) && (
          isAcademyStaff(academyId) || (
            isAcademyMember(academyId) && (
              resource.data.userId == request.auth.uid ||
              resource.data.athleteUserId == request.auth.uid ||
              (resource.data.guardianUids is list && request.auth.uid in resource.data.guardianUids)
            )
          )
        );
        allow write: if isSignedIn() && hasVerifiedEmail() && isValidId(attendanceId) && isAcademyStaff(academyId);
      }

      // Fees subcollection
      // Only academy_admin and accounting can create or update them.
      // An athlete or guardian can read only fees for athletes they are linked to.
      match /fees/{feeId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(feeId) && (
          isAcademyAccounting(academyId) || (
            isAcademyMember(academyId) && (
              resource.data.userId == request.auth.uid ||
              (resource.data.guardianUids is list && request.auth.uid in resource.data.guardianUids)
            )
          )
        );
        allow create, update: if isSignedIn() && hasVerifiedEmail() && isValidId(feeId) && isAcademyAccounting(academyId);
        allow delete: if isSignedIn() && hasVerifiedEmail() && isValidId(feeId) && isAcademyAccounting(academyId);
      }

      // Fee payments subcollection
      // Only academy_admin and accounting can create or update them.
      match /payments/{paymentId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(paymentId) && (
          isAcademyAccounting(academyId) || (
            isAcademyMember(academyId) && (
              resource.data.userId == request.auth.uid ||
              (resource.data.guardianUids is list && request.auth.uid in resource.data.guardianUids)
            )
          )
        );
        allow create, update: if isSignedIn() && hasVerifiedEmail() && isValidId(paymentId) && isAcademyAccounting(academyId);
        allow delete: if isSignedIn() && hasVerifiedEmail() && isValidId(paymentId) && isAcademyAccounting(academyId);
      }

      // Invoices subcollection
      // Only academy_admin and accounting can create or update them.
      match /invoices/{invoiceId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(invoiceId) && (
          isAcademyAccounting(academyId) || (
            isAcademyMember(academyId) && (
              resource.data.userId == request.auth.uid ||
              (resource.data.guardianUids is list && request.auth.uid in resource.data.guardianUids)
            )
          )
        );
        allow create, update: if isSignedIn() && hasVerifiedEmail() && isValidId(invoiceId) && isAcademyAccounting(academyId);
        allow delete: if isSignedIn() && hasVerifiedEmail() && isValidId(invoiceId) && isAcademyAccounting(academyId);
      }

      // Announcements subcollection
      // Announcements: staff write, academy members read.
      match /announcements/{announcementId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(announcementId) && (
          isPlatformAdmin() || isAcademyMember(academyId)
        );
        allow create, update, delete: if isSignedIn() && hasVerifiedEmail() && isValidId(announcementId) && isAcademyStaff(academyId);
      }

      // Conversations subcollection
      // Conversations: only users listed in participantUids can read or write.
      match /conversations/{conversationId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(conversationId) && (
          isPlatformAdmin() || (
            isAcademyMember(academyId) &&
            resource.data.participantUids is list &&
            request.auth.uid in resource.data.participantUids
          )
        );

        allow create: if isSignedIn() && hasVerifiedEmail() && isValidId(conversationId) && (
          isPlatformAdmin() || (
            isAcademyMember(academyId) &&
            request.resource.data.participantUids is list &&
            request.auth.uid in request.resource.data.participantUids
          )
        );

        allow update: if isSignedIn() && hasVerifiedEmail() && isValidId(conversationId) && (
          isPlatformAdmin() || (
            isAcademyMember(academyId) &&
            resource.data.participantUids is list &&
            request.auth.uid in resource.data.participantUids &&
            request.resource.data.participantUids is list &&
            request.auth.uid in request.resource.data.participantUids
          )
        );

        allow delete: if isSignedIn() && hasVerifiedEmail() && isValidId(conversationId) && (
          isPlatformAdmin() || (
            isAcademyMember(academyId) &&
            resource.data.participantUids is list &&
            request.auth.uid in resource.data.participantUids
          )
        );

        // Messages subcollection under a conversation
        // A message's senderId must equal request.auth.uid and participantUids check.
        match /messages/{messageId} {
          allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(messageId) && (
            isPlatformAdmin() || (
              isAcademyMember(academyId) &&
              get(/databases/$(database)/documents/academies/$(academyId)/conversations/$(conversationId)).data.participantUids is list &&
              request.auth.uid in get(/databases/$(database)/documents/academies/$(academyId)/conversations/$(conversationId)).data.participantUids
            )
          );

          allow create: if isSignedIn() && hasVerifiedEmail() && isValidId(messageId) && (
            isPlatformAdmin() || (
              isAcademyMember(academyId) &&
              request.resource.data.senderId == request.auth.uid &&
              get(/databases/$(database)/documents/academies/$(academyId)/conversations/$(conversationId)).data.participantUids is list &&
              request.auth.uid in get(/databases/$(database)/documents/academies/$(academyId)/conversations/$(conversationId)).data.participantUids
            )
          );

          allow update: if isSignedIn() && hasVerifiedEmail() && isValidId(messageId) && (
            isPlatformAdmin() || (
              isAcademyMember(academyId) &&
              resource.data.senderId == request.auth.uid &&
              request.resource.data.senderId == request.auth.uid &&
              get(/databases/$(database)/documents/academies/$(academyId)/conversations/$(conversationId)).data.participantUids is list &&
              request.auth.uid in get(/databases/$(database)/documents/academies/$(academyId)/conversations/$(conversationId)).data.participantUids
            )
          );

          allow delete: if isSignedIn() && hasVerifiedEmail() && isValidId(messageId) && (
            isPlatformAdmin() || (
              isAcademyMember(academyId) &&
              resource.data.senderId == request.auth.uid
            )
          );
        }
      }

      // Drills subcollection
      // Drills: staff write, academy members read.
      match /drills/{drillId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(drillId) && (
          isPlatformAdmin() || isAcademyMember(academyId)
        );
        allow create, update, delete: if isSignedIn() && hasVerifiedEmail() && isValidId(drillId) && isAcademyStaff(academyId);
      }

      // Training plans subcollection
      // Staff write, member read (athletes and guardians see only their own athlete's plans).
      match /trainingPlans/{planId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(planId) && (
          isPlatformAdmin() || isAcademyStaff(academyId) || (
            isAcademyMember(academyId) && (
              resource.data.userId == request.auth.uid ||
              resource.data.athleteUserId == request.auth.uid ||
              (resource.data.guardianUids is list && request.auth.uid in resource.data.guardianUids)
            )
          )
        );
        allow create, update, delete: if isSignedIn() && hasVerifiedEmail() && isValidId(planId) && isAcademyStaff(academyId);

        match /items/{itemId} {
          allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(itemId) && (
            isPlatformAdmin() || isAcademyStaff(academyId) || (
              isAcademyMember(academyId) && (
                get(/databases/$(database)/documents/academies/$(academyId)/trainingPlans/$(planId)).data.userId == request.auth.uid ||
                get(/databases/$(database)/documents/academies/$(academyId)/trainingPlans/$(planId)).data.athleteUserId == request.auth.uid ||
                (get(/databases/$(database)/documents/academies/$(academyId)/trainingPlans/$(planId)).data.guardianUids is list &&
                 request.auth.uid in get(/databases/$(database)/documents/academies/$(academyId)/trainingPlans/$(planId)).data.guardianUids)
              )
            )
          );
          allow create, update, delete: if isSignedIn() && hasVerifiedEmail() && isValidId(itemId) && isAcademyStaff(academyId);
        }
      }

      // Plan items subcollection
      match /planItems/{itemId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(itemId) && (
          isPlatformAdmin() || isAcademyStaff(academyId) || (
            isAcademyMember(academyId) && (
              resource.data.userId == request.auth.uid ||
              resource.data.athleteUserId == request.auth.uid ||
              (resource.data.guardianUids is list && request.auth.uid in resource.data.guardianUids)
            )
          )
        );
        allow create, update, delete: if isSignedIn() && hasVerifiedEmail() && isValidId(itemId) && isAcademyStaff(academyId);
      }

      // Assessments subcollection
      // Staff write, member read (athletes and guardians see only their own athlete's assessments).
      match /assessments/{assessmentId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(assessmentId) && (
          isPlatformAdmin() || isAcademyStaff(academyId) || (
            isAcademyMember(academyId) && (
              resource.data.userId == request.auth.uid ||
              resource.data.athleteUserId == request.auth.uid ||
              (resource.data.guardianUids is list && request.auth.uid in resource.data.guardianUids)
            )
          )
        );
        allow create, update, delete: if isSignedIn() && hasVerifiedEmail() && isValidId(assessmentId) && isAcademyStaff(academyId);
      }

      // Tactical boards subcollection
      // Tactical board: staff write, academy members read.
      match /tacticalBoards/{boardId} {
        allow read: if isSignedIn() && hasVerifiedEmail() && isValidId(boardId) && (
          isPlatformAdmin() || isAcademyMember(academyId)
        );
        allow create, update, delete: if isSignedIn() && hasVerifiedEmail() && isValidId(boardId) && isAcademyStaff(academyId);
      }
    }
  }
}
