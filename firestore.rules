rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isPlatformAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "heavylaws@gmail.com" ||
        request.auth.token.email.lower() == "ah.baalbaki@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidText(text, maxLen) {
      return text is string && text.size() <= maxLen;
    }

    // Academies Collection
    match /academies/{academyId} {
      allow read: if isValidId(academyId);
      allow create: if isPlatformAdmin() && isValidId(academyId) &&
        incoming().name is string && incoming().name.size() <= 128 &&
        incoming().sport is string && incoming().sport.size() <= 64;
      allow update: if (isPlatformAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)))) &&
        isValidId(academyId) &&
        incoming().name is string && incoming().name.size() <= 128;
      allow delete: if isPlatformAdmin();

      match /live_state/{docId} {
        allow read, write: if isValidId(academyId) && isValidId(docId);
      }
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && isValidId(userId);
      allow create: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isPlatformAdmin()) &&
        incoming().email is string && incoming().email.size() <= 128 &&
        incoming().name is string && incoming().name.size() <= 128;
      allow update: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isPlatformAdmin()) &&
        incoming().name is string && incoming().name.size() <= 128;
      allow delete: if isPlatformAdmin();
    }

    // Athletes Collection
    match /athletes/{athleteId} {
      allow read: if isSignedIn() && isValidId(athleteId);
      allow create: if isSignedIn() && isValidId(athleteId) &&
        incoming().firstName is string && incoming().firstName.size() <= 64 &&
        incoming().lastName is string && incoming().lastName.size() <= 64 &&
        incoming().academyId is string && incoming().academyId.size() <= 128;
      allow update: if isSignedIn() && isValidId(athleteId) &&
        incoming().firstName is string && incoming().firstName.size() <= 64 &&
        incoming().lastName is string && incoming().lastName.size() <= 64;
      allow delete: if isSignedIn() && (isPlatformAdmin() || exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    // Teams Collection
    match /teams/{teamId} {
      allow read: if isSignedIn() && isValidId(teamId);
      allow create: if isSignedIn() && isValidId(teamId) &&
        incoming().name is string && incoming().name.size() <= 128 &&
        incoming().academyId is string && incoming().academyId.size() <= 128;
      allow update: if isSignedIn() && isValidId(teamId) &&
        incoming().name is string && incoming().name.size() <= 128;
      allow delete: if isPlatformAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    // Team Members Collection
    match /teamMembers/{memberId} {
      allow read: if isSignedIn() && isValidId(memberId);
      allow create, update: if isSignedIn() && isValidId(memberId) &&
        incoming().teamId is string && incoming().athleteId is string;
      allow delete: if isSignedIn();
    }

    // Training Sessions Collection
    match /trainingSessions/{sessionId} {
      allow read: if isSignedIn() && isValidId(sessionId);
      allow create: if isSignedIn() && isValidId(sessionId) &&
        incoming().title is string && incoming().title.size() <= 128 &&
        incoming().startTime is string && incoming().endTime is string;
      allow update: if isSignedIn() && isValidId(sessionId) &&
        incoming().title is string && incoming().title.size() <= 128;
      allow delete: if isSignedIn();
    }

    // Attendance Records Collection
    match /attendanceRecords/{attendanceId} {
      allow read: if isSignedIn() && isValidId(attendanceId);
      allow create, update: if isSignedIn() && isValidId(attendanceId) &&
        incoming().sessionId is string && incoming().athleteId is string &&
        incoming().status is string;
      allow delete: if isSignedIn();
    }

    // Tactical Plans Collection
    match /tacticalPlans/{planId} {
      allow read: if isSignedIn() && isValidId(planId);
      allow create: if isSignedIn() && isValidId(planId) &&
        incoming().title is string && incoming().title.size() <= 128 &&
        incoming().pitchType is string;
      allow update: if isSignedIn() && isValidId(planId) &&
        incoming().title is string && incoming().title.size() <= 128;
      allow delete: if isSignedIn();
    }

    // Drills Collection
    match /drills/{drillId} {
      allow read: if isSignedIn() && isValidId(drillId);
      allow create, update: if isSignedIn() && isValidId(drillId) &&
        incoming().title is string && incoming().title.size() <= 128;
      allow delete: if isSignedIn();
    }

    // Invoices Collection
    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && isValidId(invoiceId);
      allow create, update: if isSignedIn() && isValidId(invoiceId) &&
        incoming().amount is number && incoming().currency is string;
      allow delete: if isPlatformAdmin();
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow read: if isSignedIn() && isValidId(announcementId);
      allow create: if isSignedIn() && isValidId(announcementId) &&
        incoming().title is string && incoming().title.size() <= 128 &&
        incoming().content is string && incoming().content.size() <= 3000;
      allow update: if isSignedIn() && isValidId(announcementId) &&
        incoming().title is string && incoming().title.size() <= 128;
      allow delete: if isSignedIn();
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && isValidId(conversationId);
      allow create, update: if isSignedIn() && isValidId(conversationId) &&
        incoming().type is string;
      allow delete: if isSignedIn();

      match /messages/{messageId} {
        allow read: if isSignedIn() && isValidId(messageId);
        allow create: if isSignedIn() && isValidId(messageId) &&
          incoming().text is string && incoming().text.size() <= 2000 &&
          incoming().senderId is string;
        allow update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
