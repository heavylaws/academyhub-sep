rules_version = '2';

// Security model
// --------------
// Default deny. The only data path the client uses is the per-academy sync
// document at academies/{academyId}/live_state/{docId}. Access requires a
// signed-in Firebase user with a verified email who is either:
//   - a platform admin: a document exists at /admins/{uid}, or
//   - a member of that academy: a document exists at
//     /academies/{academyId}/members/{uid}
// Both marker collections are writable only from the Firebase console / Admin
// SDK (never from the client), so a user cannot grant themselves access.
//
// No emails are hard-coded here: add platform admins by creating
// /admins/{uid} documents in the console.
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default-deny catch-all.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isPlatformAdmin() {
      return hasVerifiedEmail() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAcademyMember(academyId) {
      return hasVerifiedEmail() &&
        exists(/databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid));
    }

    function canAccessAcademy(academyId) {
      return isValidId(academyId) && (isPlatformAdmin() || isAcademyMember(academyId));
    }

    // Admin and membership markers: readable by their own user, never
    // writable from the client.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /academies/{academyId} {
      allow get: if canAccessAcademy(academyId);
      allow list, write: if false;

      match /members/{uid} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isPlatformAdmin());
        allow write: if false;
      }

      // Multi-device sync blob written by src/services/firestore-sync-service.ts.
      match /live_state/{docId} {
        allow read: if canAccessAcademy(academyId) && isValidId(docId);
        allow create, update: if canAccessAcademy(academyId) && isValidId(docId) &&
          request.resource.data.academyId == academyId &&
          request.resource.data.payload is string &&
          request.resource.data.payload.size() <= 900000;
        allow delete: if isPlatformAdmin();
      }
    }
  }
}
